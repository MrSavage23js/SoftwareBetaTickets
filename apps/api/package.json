{
  "name": "@mesa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:migrar": "tsx src/db/cli.ts migrar",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:estado": "tsx src/db/cli.ts estado",
    "crear-admin": "tsx src/db/cli.ts crear-admin"
  },
  "dependencies": {
    "@mesa/shared": "*",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "file-type": "^22.1.1",
    "helmet": "^8.1.0",
    "kysely": "^0.29.6",
    "multer": "^2.0.2",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.12",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.0",
    "supertest": "^7.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
