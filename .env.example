# =====================================================================
#  Mesa de Ayuda — variables de entorno
#  Copia este archivo como .env y ajusta los valores.
#  Las variables marcadas [OBLIGATORIA] impiden arrancar si faltan.
# =====================================================================

# --- Aplicación ------------------------------------------------------
NODE_ENV=development
PORT=3100
# URL pública con la que los usuarios abren el sistema (se usa en el botón de los correos). [OBLIGATORIA]
APP_URL=http://localhost:3100
# Zona horaria para mostrar fechas (en la BD todo se guarda en UTC).
APP_TZ=America/Mexico_City
# Nombre que aparece en la pantalla de inicio y en los correos.
APP_NOMBRE_EMPRESA=Grupo Aramo
# Nivel de registros: fatal | error | warn | info | debug
LOG_LEVEL=info
# Poner en 1 si el sistema corre detrás de IIS / nginx / proxy inverso (para leer la IP real).
TRUST_PROXY=0

# --- Base de datos (MySQL 8.4) ---------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=mesa_app
DB_PASSWORD=mesa_dev_123
DB_NAME=mesa_ayuda
DB_NAME_TEST=mesa_ayuda_test
DB_POOL_MAX=10

# --- Sesión y seguridad ----------------------------------------------
SESSION_COOKIE_NAME=mesa_sid
# true en producción (requiere HTTPS). En desarrollo con http://localhost puede ir en false.
COOKIE_SECURE=false

# --- Archivos --------------------------------------------------------
# Carpeta para adjuntos, correos de consola y respaldos. Debe estar FUERA de cualquier carpeta pública.
STORAGE_DIR=./storage
# Techo absoluto por archivo (MB). El límite real se ajusta desde la pantalla de Ajustes, sin pasar este techo.
ADJUNTOS_TECHO_MB=25

# --- Valores iniciales de los Ajustes (solo se usan la primera vez; luego se editan en pantalla) ---
SESION_INACTIVIDAD_MIN=30
SESION_MAX_HORAS=12
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=15
ADJUNTOS_MAX_MB=10
ADJUNTOS_MAX_POR_MENSAJE=5
ADJUNTOS_TIPOS=pdf,png,jpg,jpeg,gif,webp,doc,docx,xls,xlsx,csv,txt,xml,zip

# --- Correo ----------------------------------------------------------
# consola = guarda cada correo como .eml en STORAGE_DIR/correos-consola (desarrollo)
# smtp    = servidor SMTP (Office 365: smtp.office365.com, puerto 587)
# graph   = Microsoft Graph API (recomendado con Microsoft 365). Ver docs/CORREO_M365.md
MAIL_TRANSPORT=consola
MAIL_FROM=mesadeayuda@example.com
MAIL_FROM_NAME=Sistema de Tickets
# Cada cuántos segundos revisa la cola de salida.
MAIL_COLA_INTERVALO_SEG=15

SMTP_HOST=
SMTP_PORT=587
# true solo para el puerto 465 (TLS directo). Con 587 se usa STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Datos que entrega el administrador de Microsoft 365 (registro de aplicación en Entra ID).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Buzón desde el que se envía (debe existir y estar permitido en la Application Access Policy).
GRAPH_REMITENTE=

# --- Administrador inicial (se crea al correr los seeds si no existe ningún admin) ---
ADMIN_INICIAL_USUARIO=admin
ADMIN_INICIAL_EMAIL=admin@example.com
ADMIN_INICIAL_PASSWORD=CambiaEsto123

# --- Respaldos -------------------------------------------------------
RESPALDOS_DIR=./storage/respaldos
RESPALDOS_RETENCION_DIAS=30
# Ruta de mysqldump / mysql si no están en el PATH (el script local los busca solo).
MYSQLDUMP_BIN=
MYSQL_BIN=
